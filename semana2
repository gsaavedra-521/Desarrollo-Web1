<!DOCTYPE html>
<html lang="en">
<head>
  <title>Catálogo de Completos</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>

<div class="container-fluid mt-3">
    <div class="row bg-warning">
        <div class="col-12 fw-bold text-center py-2">Menú de Completos</div>
    </div>
    <div class="row bg-warning text-white text-center fw-bold">
        <div class="bg-primary col-3 py-2">Italiano</div>
        <div class="bg-secondary col-3 py-2">Dinámico</div>
        <div class="bg-primary col-3 py-2">Chacarero</div>
        <div class="bg-secondary col-3 py-2">Tradicional</div>
    </div>
    <div class="row bg-warning text-white text-center">
        <div class="bg-primary col-3 py-1">$3.590</div>
        <div class="bg-secondary col-3 py-1">$4.190</div>
        <div class="bg-primary col-3 py-1">$4.390</div>
        <div class="bg-secondary col-3 py-1">$3.790</div>
    </div>
    <div class="row bg-warning text-white text-center fw-bold">
        <div class="bg-danger col-3 py-1">AGOTADO</div>
        <div class="bg-danger col-3 py-1">AGOTADO</div>
        <div class="bg-danger col-3 py-1">AGOTADO</div>
        <div class="bg-danger col-3 py-1">AGOTADO</div>
    </div>

   <div class="row mt-5 justify-content-center">
        <div class="col-md-6">
            <label for="cmbCompletos" class="form-label fw-bold">Selecciona tu completo para pedir:</label>
            <select id="cmbCompletos" class="form-select border-primary">
            </select>
        </div>
    </div>
</div>

<script>    
const responseAPI = {
    status: 200,
        message: "Productos Disponibles",
        data: [
            { id: 1, nombre: "Italiano", precio: 3590 },
            { id: 2, nombre: "Dinámico", precio: 4190 },
            { id: 3, nombre: "Chacarero", precio: 4390 },
            { id: 4, nombre: "Tradicional", precio: 3790 }
        ]
    };
        
function cargarCompletos() {
    const select = document.getElementById("cmbCompletos");

    responseAPI.data.forEach(completo => {
        let nuevaOpcion = document.createElement("option");
        nuevaOpcion.setAttribute("value", completo.id);
        nuevaOpcion.innerText = completo.nombre;
        
        select.appendChild(nuevaOpcion);
    });
}
window.onload = cargarCompletos;
</script>

</body>
</html>
